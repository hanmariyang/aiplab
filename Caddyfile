{
	admin off
	auto_https off
	persist_config off
}

# Railway가 $PORT 를 주입 → Caddy 가 그 포트로 정적 서빙(0.0.0.0). TLS 는 Railway 엣지에서 종료.
:{$PORT:8080} {
	root * /srv
	encode gzip zstd
	header -Server

	# 방문 분석 서비스로 프록시 (사설망) — 같은 origin 이라 CORS 없음
	handle /hit {
		reverse_proxy aiplab-analytics.railway.internal:8080
	}
	handle /admin* {
		reverse_proxy aiplab-analytics.railway.internal:8080
	}
	handle /api/stats {
		reverse_proxy aiplab-analytics.railway.internal:8080
	}

	# 푸실 공유 영수증 — /pusil/r/<토큰> 을 한 페이지가 받는다.
	# ⚠️ 토큰이 경로에 있어 정적 파일로는 못 찾는다. try_files 에 맡기면 404 다
	#    (실측 2026-09-14: 공유 링크가 통째로 죽어 있었다).
	# ⛔ 이 handle 은 /pusil/r/ 하나만 잡는다 — 다른 제품 경로에 닿지 않는다.
	handle /pusil/r/* {
		rewrite * /pusil/r/index.html
		file_server
		header Cache-Control "public, max-age=60"
	}

	# 그 외: 정적 서빙 + 확장자 없는 깔끔한 URL(/blog/foo → foo.html, 기존 .html 링크도 동작)
	handle {
		# ⛔ 디렉토리를 슬래시 없이 열면 상대경로가 한 단계 위로 풀려 이미지가 전부 깨진다.
		#    try_files 가 /toegeun 을 리다이렉트 없이 200 으로 내주기 때문이다 —
		#    브라우저 기준이 / 로 남아 assets/x.jpg 가 /assets/x.jpg 가 된다.
		#    (실측 2026-09-08: /toegeun·/datgi 둘 다 엑박. 전 제품이 그랬다)
		#    ⚠️ {path}.html 이 있으면 넘기지 않는다 — /blog/foo 같은 깔끔한 URL 을 지킨다.
		@needSlash {
			not path */
			not file {path}.html
			file {path}/index.html
		}
		redir @needSlash {path}/ 308

		try_files {path} {path}.html {path}/index.html
		file_server {
			index index.html
		}
		header Cache-Control "public, max-age=300"
	}
}
