{
	admin off
	auto_https off
	persist_config off
}

# Railway가 $PORT 를 주입 → Caddy 가 그 포트로 정적 서빙(0.0.0.0). TLS 는 Railway 엣지에서 종료.
:{$PORT:8080} {
	root * /srv
	encode gzip zstd
	# 확장자 없는 깔끔한 URL: /blog/foo → foo.html (기존 .html 링크도 그대로 동작)
	try_files {path} {path}.html {path}/index.html
	file_server {
		index index.html
	}
	header {
		-Server
		Cache-Control "public, max-age=300"
	}
}
