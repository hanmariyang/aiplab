{
	admin off
	auto_https off
	persist_config off
}

# 오데이 랜딩 전용 서비스(ohday-web) — https://ohday.aiplab.kr (2026-10-01).
# aiplab-web 은 Hobby 플랜 커스텀 도메인 2개(aiplab.kr · www)가 차서 서브도메인을 못 붙였다 → 같은 프로젝트에 서비스 하나 더.
# 파일은 /srv/ohday 가 아니라 /srv 루트(이 서비스엔 오데이뿐). 정본은 ohday 레포 store/site/ohday/, 사본은 aiplab/ohday/.
:{$PORT:8080} {
	root * /srv
	encode gzip zstd
	header -Server

	# 방문 분석 — 같은 프로젝트 사설망. 랜딩의 sendBeacon('/hit') 이 이 호스트로 와도 같은 origin 이다.
	handle /hit {
		reverse_proxy aiplab-analytics.railway.internal:8080
	}

	handle {
		@needSlash {
			not path */
			not file {path}.html
			file {path}/index.html
		}
		redir @needSlash {path}/ 308
		try_files {path} {path}.html {path}/index.html
		file_server {
			index index.html
		}
		header Cache-Control "public, max-age=300"
	}
}
