{
	admin off
	auto_https off
	persist_config off
}

# 오데이 랜딩 전용 서비스(ohday-web) — https://ohday.aiplab.kr (2026-10-01).
# aiplab-web 은 Hobby 플랜 커스텀 도메인 2개(aiplab.kr · www)가 차서 서브도메인을 못 붙였다 → 같은 프로젝트에 서비스 하나 더.
# 파일은 /srv/ohday 가 아니라 /srv 루트(이 서비스엔 오데이뿐). 정본은 ohday 레포 store/site/ohday/, 사본은 aiplab/ohday/.
:{$PORT:8080} {
	root * /srv
	encode gzip zstd
	header -Server

	# 방문 분석 — 같은 프로젝트 사설망. 랜딩의 sendBeacon('/hit') 이 이 호스트로 와도 같은 origin 이다.
	handle /hit {
		reverse_proxy aiplab-analytics.railway.internal:8080
	}

	# 책 찾기(오데이 앱 읽는 책·인용 카드, 2026-10-04). 앱은 키 없이 여기로 묻고, 이 서버가 카카오 키를 붙여 그대로 넘긴다.
	# 키: Railway ohday-web 서비스 변수 KAKAO_REST_KEY(오데이 전용 카카오 앱의 REST API 키, Admin 키 금지). 저장소엔 절대 없다.
	# query·target·size 는 카카오 이름 그대로라 질의문을 손대지 않는다. 검색어를 남기지 않는다(log 지시어 없음).
	# 키가 비어 있으면 503 + 이유. 조용히 빈 결과를 주지 않는다(앱이 「결과 없음」과 「검색 불가」를 구분해 iTunes 로 넘어간다).
	# 총 쪽수(오데이 읽는 책, 2026-10-04). 국립중앙도서관 서지 API 의 PAGE. 앱은 ISBN 만 보내고 이 서버가 인증키를 붙인다.
	# 키: Railway ohday-web 변수 NL_CERT_KEY. 저장소엔 없다. ⚠️ 국중은 키가 틀려도 200 + RESULT:ERROR 를 준다(앱이 몸통을 본다).
	handle /api/pages {
		@nokey expression `{env.NL_CERT_KEY} == ""`
		handle @nokey {
			header Content-Type application/json
			respond `{"error":"pages_unavailable"}` 503
		}
		handle {
			header Cache-Control "public, max-age=86400"
			rewrite * /seoji/SearchApi.do?cert_key={env.NL_CERT_KEY}&result_style=json&page_no=1&page_size=1&isbn={query.isbn}
			reverse_proxy https://www.nl.go.kr {
				header_up Host www.nl.go.kr
				header_up -Cookie
				header_up -X-Forwarded-For
				header_down -Set-Cookie
			}
		}
	}

	handle /api/books {
		@nokey expression `{env.KAKAO_REST_KEY} == ""`
		handle @nokey {
			header Content-Type application/json
			respond `{"error":"search_unavailable"}` 503
		}
		handle {
			header Cache-Control "no-store"
			rewrite * /v3/search/book?{query}
			reverse_proxy https://dapi.kakao.com {
				header_up Host dapi.kakao.com
				header_up Authorization "KakaoAK {env.KAKAO_REST_KEY}"
				header_up -Cookie
				header_up -X-Forwarded-For
				header_down -Set-Cookie
			}
		}
	}

	handle {
		@needSlash {
			not path */
			not file {path}.html
			file {path}/index.html
		}
		redir @needSlash {path}/ 308
		try_files {path} {path}.html {path}/index.html
		file_server {
			index index.html
		}
		header Cache-Control "public, max-age=300"
	}
}
